# ==============================================================================
# FDRSetu – Environment Configuration Template
# ==============================================================================

# Application Metadata
PROJECT_NAME=FDRSetu
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=fdrsetu-super-secure-production-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL with psycopg3 dialect)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fdrsetu_db
USE_SQLITE_FALLBACK=True
SQLITE_URL=sqlite:///./fdrsetu.db

# Storage
MAX_FILE_SIZE_MB=10

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
